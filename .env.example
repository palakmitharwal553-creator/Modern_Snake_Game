# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# MongoDB Atlas connection string (replace with your actual URI)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@StudentHubCluster.mongodb.net/?retryWrites=true&w=majority

# A long, random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_string

# Port the server listens on (optional; defaults to 3000)
PORT=3000

# Set to "production" on a live server to enable secure cookies
NODE_ENV=development

