# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# MongoDB Atlas connection string (replace with your actual URI).
# Leave the placeholder to use the local file database (data/db.json) instead.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@StudentHubCluster.mongodb.net/?retryWrites=true&w=majority

# Port the server listens on (optional; defaults to 3000)
PORT=3000

# Set to 1 when the app runs behind a proxy / hosting platform (so rate limits use the real visitor IP)
# TRUST_PROXY=1
